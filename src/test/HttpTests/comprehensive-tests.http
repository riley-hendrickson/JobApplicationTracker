### ========================
### COMPANY ENDPOINTS
### ========================

### Create company 1
POST http://localhost:8080/api/companies
Content-Type: application/json

{
  "name": "Google",
  "location": "Seattle, WA",
  "website": "google.com",
  "industry": "Technology"
}

###

### Create company 2
POST http://localhost:8080/api/companies
Content-Type: application/json

{
  "name": "Microsoft",
  "location": "Redmond, WA",
  "website": "microsoft.com",
  "industry": "Technology"
}

###

### Get all companies
GET http://localhost:8080/api/companies

###

### Get company by id
GET http://localhost:8080/api/companies/1

###

### Update company
PUT http://localhost:8080/api/companies/1
Content-Type: application/json

{
  "name": "Google LLC",
  "location": "Seattle, WA",
  "website": "google.com",
  "industry": "Technology"
}

###

### ========================
### JOB LISTING ENDPOINTS
### ========================

### Create listing 1 for company 1
POST http://localhost:8080/api/job-listings
Content-Type: application/json

{
  "title": "Backend Developer",
  "description": "Java backend role focused on Spring Boot microservices",
  "salaryMin": 90000,
  "salaryMax": 120000,
  "listingStatus": "OPEN",
  "datePosted": "2026-02-01",
  "companyId": 1
}

###

### Create listing 2 for company 1
POST http://localhost:8080/api/job-listings
Content-Type: application/json

{
  "title": "Senior Engineer",
  "description": "Senior Java role with team lead responsibilities",
  "salaryMin": 130000,
  "salaryMax": 160000,
  "listingStatus": "OPEN",
  "datePosted": "2026-01-15",
  "companyId": 1
}

###

### Create listing 3 for company 2
POST http://localhost:8080/api/job-listings
Content-Type: application/json

{
  "title": "Java Developer",
  "description": "Java developer role at Microsoft",
  "salaryMin": 95000,
  "salaryMax": 125000,
  "listingStatus": "CLOSED",
  "datePosted": "2026-01-01",
  "companyId": 2
}

###

### Get all listings
GET http://localhost:8080/api/job-listings

###

### Get listing by id
GET http://localhost:8080/api/job-listings/1

###

### Search by company id
GET http://localhost:8080/api/job-listings/search?companyId=1

###

### Search by status
GET http://localhost:8080/api/job-listings/search?listingStatus=OPEN

###

### Search by company id and status
GET http://localhost:8080/api/job-listings/search?companyId=1&listingStatus=OPEN

###

### Update listing
PUT http://localhost:8080/api/job-listings/1
Content-Type: application/json

{
  "title": "Backend Developer II",
  "description": "Updated Java backend role",
  "salaryMin": 95000,
  "salaryMax": 125000,
  "listingStatus": "OPEN",
  "datePosted": "2026-02-01",
  "companyId": 1
}

